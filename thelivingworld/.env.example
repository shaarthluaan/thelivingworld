# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# PostgreSQL Database Configuration
# You can use a full connection URI:
DATABASE_URL=postgresql://username:password@localhost:5432/thelivingworld

# Or individual connection variables:
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_password_here
PGDATABASE=thelivingworld
